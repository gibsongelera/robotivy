[Unit]
Description=TempBot - Humanoid Temperature Checking Robot
Documentation=https://github.com/your-username/robotivy
After=network.target local-fs.target
Wants=network.target

[Service]
Type=simple
User=robotivy
Group=robotivy
WorkingDirectory=/home/robotivy/robotivy/raspberry_pi
ExecStartPre=/bin/mkdir -p /tmp/tempbot
ExecStart=/usr/bin/python3 /home/robotivy/robotivy/raspberry_pi/tempbot.py
Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=10s

# Environment
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Security & Sandboxing to Protect the Root Filesystem
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp/tempbot /home/robotivy/tempbot_data /dev/i2c-1 /dev/gpiomem /dev/mem
PrivateTmp=false
ProtectKernelTunables=true
ProtectControlGroups=true

[Install]
WantedBy=multi-user.target
